{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": false,
  "liveServer.settings.port": 5500,
  "liveServer.settings.CustomBrowser": "default",
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    ".git/**",
    "data/seen.json"
  ],
  "files.associations": {
    "*.json": "json",
    "*.sql": "sql"
  }
}

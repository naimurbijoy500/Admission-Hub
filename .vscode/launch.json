{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌐 Run Dev Server (http://localhost:5500)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev-server.js",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "🕷️ Run Live University Scraper (monitor.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/monitor.js",
      "console": "integratedTerminal",
      "env": {
        "SITE_URL": "https://naimurbijoy500.github.io/Admission-Hub/"
      }
    },
    {
      "name": "🔍 Debug Frontend in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
